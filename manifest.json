{
  "manifest_version": 3,
  "name": "HINTS RSEC — Ambil Data Pasien",
  "version": "0.4.0",
  "description": "Ambil identitas, BB, dan TB pasien dari HINTS RSEC untuk ditempel ke Kalkulator & Kitir.",
  "permissions": ["clipboardWrite", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://172.18.0.247/*"],
  "content_scripts": [
    {
      "matches": ["http://172.18.0.247/*"],
      "js": ["extract.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
